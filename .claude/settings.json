{
  "enabledPlugins": {
    "gh-personas@dev-flow": true,
    "build@initialcommit": true,
    "superpowers@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/no-upstream-writes.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
