# Settings of the factory loop; each is overridable by an environment variable of the same
# name, and secrets go in var/pipeline/env (git-ignored), never here.
PIPELINE_MERGE=auto
PIPELINE_PLANS=auto
PIPELINE_FINDINGS=obvious
PIPELINE_REPO=tjlytle/Sozi
PIPELINE_HUMAN=tjlytle
PIPELINE_PARALLEL=2
PIPELINE_SESSION_MINUTES=45
PIPELINE_SYNC_MINUTES=10
PIPELINE_IMAGE=sozi-factory
# The epic every finding and idea is filed under, for Tim to triage (2026-10-23).
PIPELINE_BACKLOG=172
# PIPELINE_PROFILES=auto|off  (auto: a persona's volume when it exists, else the token)
# PIPELINE_MCP_<PERSONA>=name,name  (MCP servers the persona's profile may hold; empty = none)
PIPELINE_MCP_ARCHITECT=mobbin,context7
PIPELINE_MCP_ADVOCATE=mobbin
PIPELINE_MCP_BUILDER=context7
