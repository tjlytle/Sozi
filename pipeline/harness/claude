#!/usr/bin/env bash
# Harness adapter for the Claude Code CLI (contract: pipeline/harness/README.md).
#
# Usage: claude run --prompt FILE --model M --allow FILE --checkout DIR --out DIR
#        claude resume --session ID --message FILE --model M --allow FILE --checkout DIR --out DIR
#
# Runs `claude -p` in the checkout, saves the raw stream to OUT/stream.jsonl,
# prints a readable log on stdout, and leaves OUT/session and OUT/usage.json.
# Exit: the CLI's exit status; 75 when the session was rate-limited; 64 on a bad call.
#
# Env read: CLAUDE_BIN (claude), PIPELINE_SESSION_BUDGET_USD (unset or 0: no cap),
# PLUGIN_DIR (/opt/gh-personas; passed as --plugin-dir only when it exists).
set -u

source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

new_uuid() {
    cat /proc/sys/kernel/random/uuid 2>/dev/null || uuidgen 2>/dev/null ||
        node -e 'console.log(crypto.randomUUID())'
}

# The stream-json log as readable lines (ported from the snake pipeline).
live() {
    jq -R -r --unbuffered '
    (. as $line | try fromjson catch {type: "raw", text: $line}) |
    if .type == "raw" then (.text | select(test("Permission (allow|deny) rule") | not))
    elif .type == "assistant" then
      .message.content[]? | if .type == "text" then .text
        elif .type == "tool_use" then "▶ " + .name + ": " + ((.input.description // .input.command // .input.file_path // .input.pattern // .input.prompt // "") | tostring | .[0:160])
        else empty end
    elif .type == "result" then "■ " + (.subtype // "done") + " after " + ((.num_turns // 0) | tostring) + " turns"
    else empty end'
}

# The allow list rules: comments and blank lines dropped, whitespace and CR trimmed.
read_allow() {
    mapfile -t ALLOW < <(tr -d '\r' <"$ALLOW_FILE" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' | grep -v '^#' | grep -v '^$')
}

# Run the CLI in the checkout; returns the CLI's exit status.
launch() {
    local text session_flag plugin="${PLUGIN_DIR:-/opt/gh-personas}" cmd ALLOW
    read_allow
    if [ "$MODE" = run ]; then
        text=$(cat "$PROMPT"); session_flag=(--session-id "$SESSION")
    else
        text=$(cat "$MESSAGE"); session_flag=(--resume "$SESSION")
    fi
    cmd=("${CLAUDE_BIN:-claude}" -p "$text" "${session_flag[@]}" --model "$MODEL"
        --permission-mode acceptEdits --output-format stream-json --verbose --add-dir "$OUT")
    case "${PIPELINE_SESSION_BUDGET_USD:-0}" in 0) ;; *) cmd+=(--max-budget-usd "$PIPELINE_SESSION_BUDGET_USD") ;; esac
    [ -d "$plugin" ] && cmd+=(--plugin-dir "$plugin")
    # Last, so a bare flag can never swallow another.
    [ "${#ALLOW[@]}" -eq 0 ] || cmd+=(--allowedTools "${ALLOW[@]}")
    cd "$CHECKOUT" || return 1
    "${cmd[@]}" 2>&1 | tee -a "$OUT/stream.jsonl" | live
    return "${PIPESTATUS[0]}"
}

# Write OUT/usage.json for the whole session: on resume, this call's tokens and turns
# (from the last result line of its stream) are added to the previous usage.json; the
# cost is taken as the result reports it (already cumulative), or kept when there is none.
# A call that made no model call (0 tokens) and says it failed to authenticate is "auth";
# with no result line, the call's lines that are not JSON (the CLI's own errors) say it.
write_usage() {
    local result raw prev='{}'
    result=$(tail -n "$1" "$OUT/stream.jsonl" | jq -R -c 'fromjson? | select(type == "object" and .type == "result")' 2>/dev/null | tail -n 1)
    [ -n "$result" ] || result='null'
    raw=$(tail -n "$1" "$OUT/stream.jsonl" | jq -R -r '. as $line | try (fromjson | empty) catch $line' 2>/dev/null)
    if [ "$MODE" = resume ]; then
        prev=$(jq -c 'select(type == "object")' "$OUT/usage.json" 2>/dev/null) || prev='{}'
        [ -n "$prev" ] || prev='{}'
    fi
    jq -n --argjson r "$result" --argjson prev "$prev" --arg raw "$raw" '
        ($r // {}) as $x |
        (($x.subtype // "") + " " + (($x.error // "") | tostring) + (if $x.is_error == true then " " + (($x.result // "") | tostring) else "" end)) as $text |
        (if $r == null then $raw else (($x.result // "") | tostring) + " " + (($x.error // "") | tostring) end) as $said |
        ((($x.usage.input_tokens // 0) + ($x.usage.output_tokens // 0)) == 0 and
         ($said | test("Failed to authenticate|authentication_error|\\b401\\b"))) as $auth |
        {tokensIn: (($prev.tokensIn // 0) + ($x.usage.input_tokens // 0)),
         tokensOut: (($prev.tokensOut // 0) + ($x.usage.output_tokens // 0)),
         costUsd: ($x.total_cost_usd // $prev.costUsd // 0),
         turns: (($prev.turns // 0) + ($x.num_turns // 0)),
         status: (if $auth then "auth"
                  elif $r == null then "error"
                  elif ($text | test("rate.?limit|usage limit|hit your .*limit|429|overloaded"; "i")) then "rate-limited"
                  elif (($x.subtype // "") | test("budget")) then "budget"
                  elif $x.is_error == true then "error" else "ok" end)}' >"$OUT/usage.json"
}

main() {
    local rc before
    parse_args "$@"
    [ -r "$ALLOW_FILE" ] || usage_exit
    mkdir -p "$OUT"; touch "$OUT/stream.jsonl"
    if [ "$MODE" = run ]; then SESSION=$(new_uuid); echo "$SESSION" >"$OUT/session"; fi
    before=$(wc -l <"$OUT/stream.jsonl" 2>/dev/null || echo 0)
    launch; rc=$?
    write_usage "$(( $(wc -l <"$OUT/stream.jsonl" 2>/dev/null || echo 0) - before ))"
    [ "$(jq -r .status "$OUT/usage.json")" = rate-limited ] && exit 75
    exit "$rc"
}

main "$@"
