{
    "compilerOptions": {
        "target": "es2022",
        "module": "esnext",
        "moduleResolution": "bundler",
        "lib": ["es2022", "dom", "dom.iterable"],
        "types": ["node"],
        "allowJs": true,
        "checkJs": false,
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "jsx": "react-jsx",
        "jsxImportSource": "preact"
    },
    "include": ["src/js/**/*.ts", "src/js/**/*.tsx", "test/**/*.ts", "test/**/*.tsx"],
    "exclude": ["node_modules", "build", "dist", "test/fixtures"]
}
